import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1> nRich AI with Human Intelligence!</h1>
			<pre>
				Welcome to the nRichAI - AI Consulting enriched by human intelligence. 
                                Services 
                                * Guide to start with Foundational AI.
                                * Build common usecases for AI in Health Care, FinTech & Enterprise. 
                                * How to build/train/finetune private LLMs.
                                * How to deploy LLMs.
			</pre>
        	</main>
		<Footer />
	</body>
</html>
